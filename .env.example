# Raggie environment configuration (example).
# Copy to .env and adjust. install.sh generates secrets automatically.
# NEVER commit a real .env.

# ───────────────────────── Deployment ─────────────────────────
# development | production. Unset or any value other than development/dev/local/
# test/testing is treated as PRODUCTION: every service then refuses to boot with
# default, placeholder ("change-me…") or short (<32 byte) secrets. install.sh sets
# production and generates every secret.
# NOTE: local, test and testing relax the secret checks exactly like development
# (CI and the test suites run that way). Never use any of them on a server that
# is reachable by anyone but you.
RAGGIE_ENV=development
COMPOSE_PROFILES=core             # core, plus optional mock | ollama | mcp

# ───────────────────────── Front door (Caddy) ─────────────────
# Caddy is the only service published on public interfaces: it serves the web
# app and the public edge paths (widget, chat stream) from ONE origin, and
# overwrites X-Forwarded-For with the real client IP (rate limits can't be spoofed).
# Empty RAGGIE_DOMAIN = plain HTTP on HTTP_PORT (local / LAN). Set it to serve
# https://<domain> with automatic Let's Encrypt (ports 80 and 443 must be
# reachable from the internet); then also set ENABLE_HSTS=true.
RAGGIE_DOMAIN=
ACME_EMAIL=                       # optional, for Let's Encrypt expiry notices
HTTP_PORT=80
HTTPS_PORT=443

# ───────────────────────── Web (Next.js) ──────────────────────
WEB_PORT=3000                     # loopback-only debug port (http://127.0.0.1:3000)
NEXT_PUBLIC_DEFAULT_LOCALE=en     # en | tr — default UI language
# Default language for newly created users, and the fallback for edge error
# messages and LLM prompt templates when a request carries no locale
# (empty = NEXT_PUBLIC_DEFAULT_LOCALE). Answers always follow the language of the
# user's question.
DEFAULT_LOCALE=
# IANA timezone for new users and scheduled tasks that don't pick one (the web
# pre-fills the browser's zone). Existing users/tasks keep their timezone.
DEFAULT_TIMEZONE=UTC
# Empty = secure automatically in production, insecure in development. Set false
# only for an intentional plain-HTTP deployment (no RAGGIE_DOMAIN, opened via a
# LAN IP) — otherwise production login fails because cookies require HTTPS.
COOKIE_SECURE=
# Server-side base URL for the control-plane API (used by server actions):
CONTROL_PLANE_URL=http://control-plane:8000
# Server-side base URL the Next.js /api/chat proxy uses to reach the Go edge:
EDGE_URL=http://edge:8080
# Public origin where the widget loader (embed.js) is served (onboarding snippet).
# This is the Caddy origin: http://localhost locally, https://<RAGGIE_DOMAIN> in
# production. The edge port itself is not public.
WIDGET_EMBED_BASE_URL=http://localhost
# Send Strict-Transport-Security on page responses. Enable ONLY when the site is
# served over HTTPS (read at runtime, so prebuilt images honour it).
ENABLE_HSTS=false
# Optional comma-separated public origins accepted by the web API CSRF origin
# check. Only needed when a reverse proxy rewrites Host without X-Forwarded-Host.
PUBLIC_WEB_URL=

# ───────────────────────── Go chat/RAG edge ───────────────────
EDGE_PORT=8080                    # edge's own listen port inside the container
EDGE_HOST_PORT=8080               # loopback-only debug port on the host
EDGE_LOG_LEVEL=info
# Max concurrent chat SSE streams per edge replica. Past it a new chat gets a
# retryable 503 `busy` (Retry-After: 1) before any stream byte; 0 = unlimited.
# Metrics: raggie_edge_sse_streams / _limit / _rejected_total.
EDGE_MAX_SSE_CONNECTIONS=12500
# Overall budget for dependency checks served by edge /readyz:
EDGE_READINESS_TIMEOUT_SECONDS=3
# Graceful shutdown: on SIGTERM /readyz flips to 503, in-flight SSE answers may
# finish for this long, then remaining streams get a `reconnect` event. Keep it
# below the orchestrator grace period minus ~3s (k8s default grace = 30s).
EDGE_SHUTDOWN_DRAIN_SECONDS=25
# Seconds to keep serving new streams after SIGTERM while readiness already
# fails, so load-balancer endpoint removal propagates (preStop-sleep replacement;
# k8s: 5). Boot warns when delay + drain + 3s does not fit the grace period below.
EDGE_SHUTDOWN_DELAY_SECONDS=0
EDGE_TERMINATION_GRACE_SECONDS=30        # set to the pod's terminationGracePeriodSeconds
# Prometheus /metrics is served on a separate, internal-only listener (never on
# the public port). Use :9090 for in-cluster scraping; METRICS_TOKEN (optional)
# requires "Authorization: Bearer <token>" on /metrics.
METRICS_ADDR=127.0.0.1:9090
METRICS_TOKEN=                          # also guards control-plane GET /metrics when set (>=32 bytes)
# Max chat request body. 21 MiB fits 4 inline images of 5 MB; use 262144 if
# image attachments are not used.
CHAT_MAX_BODY_BYTES=22020096
# Relay the model's raw chain-of-thought on the SSE `thinking` channel. Off by
# default: reasoning can echo retrieved content or prompt internals.
STREAM_REASONING=false
# Stored messages the edge replays as conversation history on each turn (newest
# first; 0 disables history). Client-sent history on a new conversation is
# capped the same way. Code default 16.
# HISTORY_MAX_MESSAGES=16
# Valkey/Redis-backed sliding-window rate limits (fail-open if it is unavailable).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_USER_PER_MINUTE=30
RATE_LIMIT_CHAT_WIDGET_SESSION_PER_MINUTE=10
RATE_LIMIT_CHAT_WIDGET_IP_PER_MINUTE=30   # per client IP per workspace
RATE_LIMIT_WIDGET_TOKEN_PER_MINUTE=10     # per client IP per workspace
RATE_LIMIT_WIDGET_TOKEN_IP_PER_MINUTE=30  # per client IP across all workspaces (workspace_id is client-chosen)
# Seconds a client may take to send a JSON request body to the edge, in [1,600].
# Covers the body read only; streaming (SSE) answers are not affected.
HTTP_BODY_READ_TIMEOUT_SECONDS=30
# Comma-separated CIDRs/IPs of reverse proxies whose X-Forwarded-For is trusted
# for client-IP rate limiting. Compose sets private ranges for the edge (only
# Caddy and in-network services can reach it); control-plane trusts loopback +
# private ranges by default. On Kubernetes set it to your ingress range. If a
# CDN/proxy sits in front of Caddy, configure `trusted_proxies` in the Caddyfile.
# TRUSTED_PROXY_CIDRS=
# Expose MCP tools that are not provably read-only (readOnlyHint / read verbs).
MCP_ALLOW_WRITE_TOOLS=false

# ───────────────────────── Control plane (FastAPI) ────────────
CONTROL_PLANE_PORT=8000
CONTROL_PLANE_LOG_LEVEL=info
# Legacy multipart/form-data uploads are capped to keep the web/API process from
# buffering large files. Larger files automatically use resumable multipart.
DIRECT_UPLOAD_MAX_BYTES=33554432       # 32 MiB
UPLOAD_PART_SIZE=16777216              # 16 MiB per resumable part
MAX_UPLOAD_BYTES=10737418240           # 10 GiB hard per-document ceiling
# Apply pending migrations at startup (advisory-locked, safe with replicas).
# Set false when a separate migration job runs them (Helm chart, k8s); /readyz
# then stays 503 until the schema matches the code.
RUN_MIGRATIONS_ON_BOOT=true
# Optional update check: a plain GET of this release manifest (empty = off).
RELEASE_MANIFEST_URL=

# ───────────────────────── PostgreSQL ─────────────────────────
# Host-published datastore ports bind to loopback by default. Change to 0.0.0.0
# only behind an explicit firewall/VPN policy.
DATASTORE_BIND_HOST=127.0.0.1
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=raggie
POSTGRES_USER=raggie
# Dev default; install.sh generates a strong value. Keep this in sync with DATABASE_URL.
POSTGRES_PASSWORD=raggie
# Full DSN used by all services (control-plane prefers this; edge/workers need it).
# Required outside development: the edge refuses to start without it.
DATABASE_URL=postgresql://raggie:raggie@postgres:5432/raggie

# ───────────────────────── Redis (served by Valkey) ───────────
REDIS_HOST=redis
REDIS_PORT=6379
# Empty = no Valkey auth (dev only; the port binds to loopback). When set, Valkey
# runs with --requirepass and REDIS_URL MUST carry the same password:
#   REDIS_URL=redis://:<password>@redis:6379/0
# install.sh generates both.
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379
# HA (Redis/Valkey Sentinel). When BOTH are set, services connect through
# Sentinel failover and REDIS_URL is ignored; REDIS_PASSWORD authenticates to the
# data nodes, REDIS_SENTINEL_PASSWORD to the sentinels. Half-configured = boot error.
REDIS_SENTINEL_ADDRS=                   # e.g. sentinel-0:26379,sentinel-1:26379,sentinel-2:26379
REDIS_SENTINEL_MASTER=                  # e.g. raggie
REDIS_SENTINEL_PASSWORD=
REDIS_DB=0

# ───────────────────────── Qdrant ─────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_GRPC_PORT=6334
QDRANT_HTTP_PORT=6333
# Empty = no Qdrant auth (dev only). When set, Qdrant enforces it and edge,
# workers and control-plane send it as the api-key header. install.sh generates it.
QDRANT_API_KEY=

# ───────────────────────── Object storage (S3) ────────────────
# Raw uploaded files. The bundled store is SeaweedFS (Apache-2.0, S3 API on :9000);
# any S3-compatible service works — point MINIO_ENDPOINT and the credentials at it.
# (The MINIO_* names are kept for compatibility; they are generic S3 settings.)
MINIO_ENDPOINT=objectstore:9000
MINIO_API_PORT=9000
MINIO_ROOT_USER=raggie
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=raggie-uploads
MINIO_USE_SSL=false

# ───────────────────────── Web search fallback (Brave) ────────
# Global kill-switch; also needs the per-workspace toggle in /admin/workspaces.
WEB_SEARCH_ENABLED=false
# Let anonymous widget visitors trigger web / deep research (paid outbound
# Brave calls). Needs WEB_SEARCH_ENABLED and the workspace toggle as well;
# internal chats are unaffected by this switch.
WIDGET_WEB_SEARCH_ENABLED=false
BRAVE_API_KEY=
WEB_SEARCH_TOP_N=10
WEB_SEARCH_READ_ENABLED=true
WEB_SEARCH_READ_TOP_N=8
WEB_SEARCH_FETCH_CONCURRENCY=4
WEB_SEARCH_FETCH_TIMEOUT_SECONDS=5
WEB_SEARCH_MAX_BODY_BYTES=1500000
WEB_SEARCH_COUNTRY=TR
WEB_SEARCH_LANG=auto
# Deep research mode (deep_search): max sub-queries a question is decomposed into
# (the original question always counts as one). Each covers a distinct angle
# (background, current state, key players, data, risks, examples).
DEEP_SEARCH_MAX_QUERIES=6
# Per-sub-query result count for deep mode's Brave calls (vs. WEB_SEARCH_TOP_N for
# the single-web path). Higher for more breadth before deduping by URL.
DEEP_SEARCH_TOP_N=10
# Cap on the deduped web results gathered across ALL deep-research sub-queries
# before synthesis — bounds prompt size and keeps [n] citation labels manageable.
DEEP_SEARCH_MAX_RESULTS=50
# Concurrent Brave query fan-out. Results are merged round-robin by query so one
# angle cannot consume the whole evidence budget. Set 1 for strict rate limits.
DEEP_SEARCH_PARALLELISM=2
DEEP_SEARCH_READ_TOP_N=30
DEEP_SEARCH_EVIDENCE_TOP_K=20
DEEP_SEARCH_TOTAL_TIMEOUT_SECONDS=45
DEEP_SEARCH_FOLLOWUP_ROUNDS=1

# ───────────────────────── Personalization ────────────────────
# Asker profile -> prompt. Global kill-switch ON, but STILL gated per-workspace
# (workspaces.personalization_enabled, default OFF) and only for authenticated
# INTERNAL users. The per-workspace toggle is the privacy opt-in (data leaves to
# the external LLM). Set false to hard-disable everywhere.
PERSONALIZATION_ENABLED=true

# Durable per-user memory (facts extracted across chats and sent to the LLM with
# later answers). Double-gated: this global kill switch AND the per-workspace
# "Memory" toggle, which is OFF by default. Authenticated internal chats only —
# never widget visitors. Users can always view and delete their stored memory.
MEMORY_ENABLED=true
# Best-effort extraction is shed when all slots are busy; it never delays chat.
MEMORY_MAX_CONCURRENCY=8
MEMORY_JOB_TIMEOUT_SECONDS=30

# ───────────────────────── Integrations (encryption at rest) ──
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENC_KEY=

# ───────────────────────── MCP tool use (Jira, read-only) ─────
# The chat LLM can call Jira READ tools via a self-hosted mcp-atlassian container.
# GLOBAL kill-switch, default OFF: when false the chat is byte-for-byte unchanged
# (no tools advertised, no MCP connection). Tools are also gated per-org by a
# CONNECTED `jira` integration (provider='jira', status='connected').
MCP_ENABLED=false
# Internal streamable-HTTP endpoint of the mcp-atlassian container (no host port):
MCP_ATLASSIAN_URL=http://mcp-atlassian:9000/mcp
# Max agentic tool-calling iterations per chat (Stream -> run tools -> Stream ...).
# Clamped to 1..8.
MCP_MAX_ITERATIONS=4
# Jira Cloud credentials held by the mcp-atlassian container (the edge never reads
# them). Jira Cloud: site URL, your email, an API token from id.atlassian.com.
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=

# ───────────────────────── Unified agentic turn ───────────────
# GLOBAL kill-switch for the unified agentic loop. Default OFF: when false the
# chat handler keeps its legacy three-branch path (documents / web / deep + the
# MCP tools loop) byte-for-byte. When true, RAG documents are always-on grounding
# and web / deep / MCP become tools seeded from the per-turn request flags
# (web_search / deep_search / mcp_tools). With it on but no tool enabled on a
# workspace, a turn is exactly ONE Stream call — pure documents RAG, identical to
# today.
AGENT_UNIFIED_LOOP=false
# Which grounding sources are placed in the prompt by default: best | web-only |
# all. "best" (default) = documents grounding only unless a tool is enabled.
HYBRID_CONTEXT_MODE=best
# Max iterations for the unified agentic loop (Stream -> run tools -> Stream ...).
# Defaults to MCP_MAX_ITERATIONS; clamped to 1..8.
AGENT_MAX_ITERATIONS=4

# ───────────────────────── Vision ─────────────────────────────
# Comma-separated chat models that accept image inputs; empty = vision off.
VISION_MODELS=

# ───────────────────────── Tool-calling models ────────────────
# Comma-separated chat models that support OpenAI function/tool calling. The
# unified loop only advertises tools (MCP) to a model in this list; a model NOT
# listed never receives a tools/tool_choice payload (so it can't reject the
# request mid-stream — MCP just becomes a no-op for that turn). Default seeds the
# current default chat model so MCP works out of the box.
TOOL_MODELS=gpt-oss-120b
# Comma-separated models that accept reasoning_effort in legacy single-provider
# mode. Explicit model profiles declare this capability per canonical model.
REASONING_MODELS=gpt-oss-120b

# ───────────────────────── Chat LLMaaS (OpenAI-compatible /v1) ─
# The chat provider. NOTE: this provider has no embeddings endpoint — embeddings
# are served locally by the embeddings service below.
# Zero-key options:
#   make up-demo    → deterministic mock LLM (templated answers with citations)
#   make up-ollama  → bundled Ollama (local model below; CPU works, GPU optional
#                     via deploy/compose/docker-compose.gpu.yml)
LLMAAS_BASE_URL=https://api.llmaas.example/v1
LLMAAS_API_KEY=change-me-llmaas-key
LLMAAS_CHAT_MODEL=gpt-oss-120b

# Mock LLM (`mock` profile, `make up-demo`). Compose passes only the next two
# settings to it; MOCKLLM_TOOL_CALLS, MOCKLLM_REASONING and MOCKLLM_API_KEY are
# read only when running the mockllm binary directly.
# Model ids the mock serves (code default: these two).
# MOCKLLM_MODELS=gpt-oss-120b,raggie-mock
# Pause between streamed tokens; the code default is none, compose sets 15 ms.
# MOCKLLM_TOKEN_DELAY_MS=15
# Answer template language of the mock, en or tr (code default: en); only the
# template prose switches, citations keep their [n] labels. Read only when
# running the mockllm binary directly, like the knobs listed above.
# MOCKLLM_LANGUAGE=en

# Optional provider-aware model registry. Empty preserves the legacy single
# LLMAAS_* endpoint above. When set, each canonical id is fail-closed and routes
# to its own OpenAI-compatible endpoint/upstream model. Secrets are referenced by
# env-var NAME, never embedded in this JSON. Models sharing a provider must use
# the same base_url, api_key_env, max_concurrency and
# response_header_timeout_seconds; that provider gets one
# isolated concurrency pool. Supported capabilities: reasoning, tools, vision.
LLM_MODEL_PROFILES_JSON=
# Bundled Ollama (`ollama` profile / docker-compose.ollama.yml overlay).
# Default: Qwen3-4B-Instruct-2507 (Apache-2.0, multilingual incl. Turkish, ~2.5 GB).
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_CONTEXT_LENGTH=16384             # must fit ~12 retrieved chunks + the question
OLLAMA_KEEP_ALIVE=24h
# Example (keep on one line in the real .env):
# LLM_MODEL_PROFILES_JSON=[{"id":"local-general","provider":"ollama","base_url":"http://ollama:11434/v1","upstream_model":"qwen3:14b","max_concurrency":2,"max_tokens":4096,"capabilities":["reasoning","tools"]},{"id":"managed-vision","provider":"managed","base_url":"https://api.llmaas.example/v1","api_key_env":"LLMAAS_API_KEY","upstream_model":"vision-model","max_concurrency":32,"max_tokens":4096,"capabilities":["vision","tools"]}]
# Ollama's OpenAI-compatible endpoint commonly accepts no key, so omit
# api_key_env. If a gateway requires auth, set OLLAMA_API_KEY and reference it;
# a referenced but empty secret is a boot-fatal configuration error.
OLLAMA_API_KEY=
# Default chain-of-thought depth for reasoning models (allowed: low|medium|high).
# Sent as "reasoning_effort". A valid per-request value overrides it; an invalid
# one falls back here. gpt-oss reasons regardless — this only tunes how deeply.
# The model streams its reasoning first; it is relayed to clients on the
# `thinking` SSE channel only when STREAM_REASONING=true (never persisted).
LLMAAS_REASONING_EFFORT=medium
# Bounded outbound concurrency from each edge replica to the shared LLM
# upstream (usually the real throughput ceiling, more than edge connection
# limits). The eval worker's judge has its own cap, EVAL_MAX_CONCURRENCY.
LLMAAS_CHAT_MAX_CONCURRENCY=64
# Seconds the edge waits for an LLM endpoint's response headers (its first byte)
# before failing the request, in [5,900]. Applies to every edge LLM call (chat,
# web-research planning, model listing) — not to embeddings, reranker, Qdrant,
# MCP or web fetches. CPU-only local models can take minutes to process a long
# prompt: docker-compose.ollama.yml sets 300 (left commented here so that
# overlay default is not overridden). A model profile can override it per
# provider with "response_header_timeout_seconds" in LLM_MODEL_PROFILES_JSON.
# LLMAAS_RESPONSE_HEADER_TIMEOUT_SECONDS=60

# ───────────────────────── Embeddings & reranker ─────────────
# The embeddings service is the single internal gateway the edge and workers call.
# It runs either LOCAL models (default; document text never leaves the server) or
# proxies dense embeddings / reranking to a CLOUD provider. BM25 sparse vectors are
# always computed locally, so hybrid search works in both modes. `install.sh` and
# `make setup` ask which mode to use; see docs/embeddings.md.
#
# Switching the dense model changes the vector space: each profile gets its own
# Qdrant collection (raggie_chunks_d{dim}[_{fingerprint}]) and existing documents
# must be re-embedded (Admin → AI → Embeddings, or EMBEDDINGS_REEMBED_CONFIRM).
EMBEDDINGS_BASE_URL=http://embeddings:8002/v1
EMBEDDINGS_PROVIDER=local               # local | openai_compatible
EMBEDDINGS_BAKE=dense,sparse,rerank     # image build: models to bake ("sparse" for cloud mode)
# Local: intfloat/multilingual-e5-large (MIT, TR+EN, 1024-d, ~2.2 GB RAM).
# Cloud: the provider's versioned model id, e.g. text-embedding-3-large.
EMBEDDINGS_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024                      # enforced by a startup probe
# Unset = automatic (e5 models get "query: "/"passage: " locally; cloud gets none).
# EMBEDDINGS_QUERY_PREFIX=
# EMBEDDINGS_PASSAGE_PREFIX=
#
# CLOUD mode only. ⚠ Document text and user questions are sent to this provider;
# under KVKK/GDPR you need a legal basis / DPA for that transfer.
# Keys belong in .env.embeddings (mode 600), which compose passes ONLY to the
# embeddings service — never put them in this shared file.
EMBEDDINGS_UPSTREAM_BASE_URL=           # OpenAI-compatible base; the gateway POSTs {base}/embeddings
# Provider-specific request fields as JSON objects, merged into upstream bodies:
EMBEDDINGS_REQUEST_EXTRA_JSON=          # e.g. {"dimensions":1024}
EMBEDDINGS_QUERY_EXTRA_JSON=            # e.g. {"input_type":"query"} or {"task":"retrieval.query"}
EMBEDDINGS_PASSAGE_EXTRA_JSON=          # e.g. {"input_type":"document"}
EMBEDDINGS_QUERY_TIMEOUT_SECONDS=3
EMBEDDINGS_QUERY_RETRIES=1
EMBEDDINGS_PASSAGE_TIMEOUT_SECONDS=60
EMBEDDINGS_PASSAGE_RETRIES=5            # full-jitter backoff; honours Retry-After
EMBEDDINGS_RETRY_BACKOFF_BASE_SECONDS=0.5
EMBEDDINGS_RETRY_BACKOFF_MAX_SECONDS=30
EMBEDDINGS_UPSTREAM_CONCURRENCY=8       # upstream slots per gateway replica...
EMBEDDINGS_QUERY_RESERVED_SLOTS=2       # ...of which these serve only search queries
EMBEDDINGS_UPSTREAM_BATCH_SIZE=64
EMBEDDINGS_UPSTREAM_BATCH_MAX_CHARS=200000
EMBEDDINGS_MAX_INPUT_CHARS=8000
EMBEDDINGS_PROBE_INTERVAL_SECONDS=30
# Query-embedding cache in Valkey/Redis (keyed by model fingerprint), mainly to cut cloud
# latency and cost for repeated questions.
EMBEDDINGS_CACHE_ENABLED=true
EMBEDDINGS_CACHE_TTL_SECONDS=86400
EMBEDDINGS_CACHE_TIMEOUT_SECONDS=0.5    # hard bound per cache call; on failure the cache is bypassed for 30 s
# EMBEDDINGS_CACHE_REDIS_URL=           # default: REDIS_URL
# Unset = automatic: required in cloud mode, with a remote reranker (cohere/voyage/
# tei) and whenever INTERNAL_API_SECRET is set (edge, workers and control-plane all
# send it as the bearer); off only for a fully local install without a secret.
# false opts out; with an upstream API key configured it refuses to boot outside
# development (anything on the network could spend that key).
# EMBEDDINGS_REQUIRE_AUTH=
# What control-plane does when the gateway's model fingerprint differs from the
# one the stored documents were embedded with: block_ingest | refuse_boot | auto_reindex.
EMBEDDINGS_FINGERPRINT_POLICY=block_ingest
EMBEDDINGS_REEMBED_CONFIRM=             # set to the NEW fingerprint to allow auto_reindex
EMBEDDINGS_INFO_TTL_SECONDS=60          # control-plane cache/recheck interval for the gateway profile

# Ingestion concurrency. Embedding is CPU-BOUND, so total concurrent embeds should
# be ~= core count — over-parallelizing THRASHES (and floods the embeddings service
# until it drops connections), making ingestion slower AND failing docs. On an
# 8-core box, a proven-stable config is: 2 embeddings replicas x EMBEDDINGS_ONNX_THREADS=4
# (= 8 cores) and INGEST_MAX_CONCURRENCY=2 with 2 ingestion-worker replicas (= 4
# docs in flight). Scale at deploy: docker compose up -d --scale embeddings=2
# --scale ingestion-worker=2.
EMBEDDINGS_ONNX_THREADS=4               # ONNX intra-op threads PER embeddings replica
# Max documents ONE ingestion worker embeds/upserts concurrently (bounds the load
# on the embeddings service). Total in-flight = ingestion-worker replicas x this.
INGEST_MAX_CONCURRENCY=2
# Worker → embeddings gateway (batched passage embedding; honours 429 Retry-After).
EMBED_TIMEOUT_SECONDS=180
EMBED_MAX_RETRIES=6
# HA: applied only when a Qdrant collection is first created (distributed Qdrant).
QDRANT_REPLICATION_FACTOR=1
QDRANT_SHARD_NUMBER=1
QDRANT_WRITE_CONSISTENCY_FACTOR=1
# Each document is parsed in an isolated child process with these hard bounds;
# the child is killed on timeout or crash and the document ends FAILED with a reason.
# OOXML files are rejected before decompression if their expanded archive exceeds
# the limit; extracted text/cell/shape ceilings bound memory and prompt-index size.
PARSER_TIMEOUT_SECONDS=120
PARSER_MAX_PDF_PAGES=1000               # PDFs with more pages are rejected up front
PARSER_OCR_MAX_PIXELS=25000000          # per-bitmap OCR pixel budget (render scale shrinks to fit)
PARSER_MAX_ARCHIVE_UNCOMPRESSED_BYTES=268435456  # 256 MiB expanded OOXML ceiling
PARSER_MAX_EXTRACTED_CHARS=10000000
PARSER_MAX_XLSX_CELLS=1000000
PARSER_MAX_PPTX_SHAPES=50000

# Hybrid search: BM25 sparse vectors (lexical) fused with dense via Qdrant RRF.
# The embeddings service produces them; the workers index them; the edge queries
# both. Set SPARSE_ENABLED=false everywhere to fall back to dense-only.
SPARSE_ENABLED=true
SPARSE_MODEL=Qdrant/bm25

# Cross-encoder reranker (gateway /v1/rerank, called by the edge after hybrid
# fusion). Fail-open: on error or timeout the fused order is kept.
RERANKER_ENABLED=true
RERANKER_PROVIDER=local                 # local | cohere | voyage | tei | none
# Local default: Alibaba-NLP/gte-multilingual-reranker-base (Apache-2.0, int8).
# Higher quality, ~2x slower on CPU: BAAI/bge-reranker-v2-m3 (Apache-2.0).
# (jinaai/jina-reranker-v2-base-multilingual is CC-BY-NC — non-commercial only.)
RERANKER_MODEL=Alibaba-NLP/gte-multilingual-reranker-base
RERANKER_BATCH_SIZE=8                   # pairs per ONNX pass; bounds RAM (~1 GB)
RERANKER_MAX_DOC_CHARS=4000
RERANKER_TIMEOUT_SECONDS=3              # cloud rerank calls
RERANKER_UPSTREAM_URL=                  # cloud: full rerank endpoint URL (key in .env.embeddings)

# ───────────────────────── Retrieval tuning (edge) ────────────
# CANDIDATE_K chunks are pulled from Qdrant, (optionally) reranked, then trimmed
# to CONTEXT_K before the prompt is built. RERANK_ENABLED is the edge-side switch
# for calling /rerank; LOW_CONFIDENCE_SCORE>0 hints the model when the best match
# is weak (it still answers). Scales differ for dense vs rerank — leave 0 to start.
# Quality-tuned defaults: pull a wider candidate pool (80) so the cross-encoder
# reranker has more to choose from, and keep a richer 12-chunk context for synthesis
# (chunks are ~1500 chars). LOW_CONFIDENCE_SCORE stays 0 until tuned on the eval set.
RETRIEVE_CANDIDATE_K=80
RETRIEVE_CONTEXT_K=12
# Soft diversity cap. If too few documents exist, remaining slots are backfilled
# with the next best chunks from the same document.
RETRIEVE_MAX_CHUNKS_PER_DOCUMENT=3
RETRIEVE_LOW_CONFIDENCE_SCORE=0
RERANK_ENABLED=true
# Bound CPU cross-encoder work independently from the wider RRF recall pool.
# Reranking 24 chunks of ~1500 chars on 4 CPU threads can exceed the edge's 5 s
# rerank timeout (then it fails open and is skipped). 12 is a provisional default
# until the published benchmark sweep (docs/benchmarks/) settles it; raise it on
# faster hardware or with a GPU/cloud reranker.
RERANK_CANDIDATE_K=12
# Edge → embeddings gateway timeouts. Query embedding is on the chat hot path;
# rerank fails open (a timeout only skips reranking and increments
# raggie_edge_rerank_fail_open_total on the edge metrics listener).
EMBED_QUERY_TIMEOUT_MS=8000
RERANK_TIMEOUT_MS=5000

# ───────────────────────── Auth / security ────────────────────
JWT_SECRET=change-me-to-a-random-32-byte-min-secret   # install.sh generates this
JWT_ACCESS_TTL_SECONDS=28800            # 8 hours (full workday)
JWT_REFRESH_TTL_SECONDS=2592000         # 30 days
# Refresh tokens rotate on every use; presenting a rotated-out token revokes the
# session (theft detection). Within this many seconds after a rotation the
# immediately previous token is still accepted, so concurrent refreshes from
# several web replicas don't log users out. 0 = strict.
REFRESH_REUSE_GRACE_SECONDS=30
WIDGET_TOKEN_SECRET=change-me-to-a-random-32-byte-min-secret
WIDGET_TOKEN_TTL_SECONDS=1800           # widget visitor token lifetime (30 min)
INVITE_TTL_SECONDS=604800               # 7 days
# Server-to-server secret (>=32 bytes; install.sh generates it). Used for the
# scheduler worker → edge /api/v1/internal/run-task call, and sent by the edge,
# workers and control-plane as `Authorization: Bearer` to the embeddings gateway
# (REQUIRED in cloud embeddings mode). Empty disables the run-task endpoint.
INTERNAL_API_SECRET=
# One-time token required by the first-admin (bootstrap) form. install.sh
# generates it and prints it. If unset outside development, control-plane
# generates one on first boot and prints it once in its logs.
SETUP_TOKEN=
# Swagger/ReDoc/OpenAPI are served only in development unless this is true.
EXPOSE_API_DOCS=false
# Login brute-force protection: per-IP sliding window, plus a per-account
# progressive lockout (base seconds, doubling per extra failure, capped at max).
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_BASE_SECONDS=30
LOGIN_LOCKOUT_MAX_SECONDS=900

# ───────────────────────── SSO (OIDC) / SCIM ──────────────────
# Experimental: API-level only (no login button in the web UI yet). Accounts are
# linked by (issuer, subject); first-time linking by email requires
# email_verified, and local-password or admin accounts are never auto-linked.
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTHORIZE_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_ISSUER=                            # expected `iss` of the ID token
OIDC_JWKS_URL=                          # set to verify ID-token signatures (recommended)
OIDC_REDIRECT_URL=http://localhost:8000/api/v1/auth/sso/callback
OIDC_DEFAULT_ROLE=STAFF
SSO_STATE_TTL_SECONDS=600
SCIM_ENABLED=false
SCIM_BEARER_TOKEN=                      # >=32 random bytes when SCIM is enabled
SCIM_ORG_ID=                            # UUID of the single org SCIM provisions into (required when SCIM_ENABLED=true)

# ───────────────────────── Workers ────────────────────────────
# A worker process runs one role; compose runs one container per role.
WORKER_ROLE=ingestion                   # ingestion | eval | scheduler
WORKER_LOG_LEVEL=info
WORKER_HEALTH_PORT=9100                 # /healthz /readyz /metrics for k8s probes
# Scheduler worker: how often (seconds) it polls scheduled_tasks for due runs.
# It calls the edge run-task endpoint (needs INTERNAL_API_SECRET above; empty → idle).
SCHEDULER_POLL_SECONDS=30
# Total seconds the scheduler waits for one task run on the edge, in [10,1800];
# a run that exceeds it is recorded as failed (last_status=error + a
# notification). Must exceed the edge's first-byte wait plus generation:
# docker-compose.ollama.yml sets 420. Left commented so that default applies.
# SCHEDULER_TASK_TIMEOUT_SECONDS=150
# Document auto-retry sweep (folded into the scheduler worker — no extra service).
# Every RETRY_SWEEP_SECONDS it re-enqueues FAILED docs whose exponential backoff
# (1, 2, 4, ... minutes, capped at RETRY_BACKOFF_CAP_SECONDS) has elapsed, up to the
# per-doc max_retries cap (default 3, stored on the documents row). Runs regardless
# of INTERNAL_API_SECRET (it only re-publishes events, never calls the edge).
RETRY_SWEEP_SECONDS=60
RETRY_BACKOFF_CAP_SECONDS=3600          # max delay between two retry attempts
RETRY_SWEEP_BATCH=50                    # max FAILED docs re-armed per sweep tick
# Stale-document sweep (same scheduler loop): live documents stuck in PENDING or
# PROCESSING for longer than this (e.g. an event lost in a Valkey failover, or a
# worker that crashed mid-document) are re-published. Workers heartbeat
# documents they are processing, so active work never looks stale.
STALE_PENDING_SECONDS=900               # min 60; must exceed INGEST_HEARTBEAT_SECONDS
STALE_PENDING_BATCH=50
INGEST_HEARTBEAT_SECONDS=60

# ───────────────────────── Auto-evaluator ─────────────────────
EVAL_FAITHFULNESS_THRESHOLD=0.7
EVAL_CITATION_VALIDITY_THRESHOLD=1.0     # any citation to a missing source flags the turn
EVAL_CITATION_COVERAGE_THRESHOLD=0.6     # min substantive claims supported by valid [n]
EVAL_QPS_THRESHOLD=20                   # evaluate every turn up to this throughput
EVAL_SAMPLE_RATE=1.0                    # deterministic fraction retained above threshold
# Total seconds one faithfulness-judge call may take, in [5,900]. The judge is
# non-streaming, so this covers prompt processing and the whole reply. A call
# that runs out of time leaves the answer unscored (citations are still
# checked); it is not retried. CPU-only local models need minutes:
# docker-compose.ollama.yml sets 300. Left commented so that default applies.
# EVAL_LLM_TIMEOUT_SECONDS=30
# Concurrent judge calls per eval worker. They share the LLM with chat, so a
# single local model wants 1 (docker-compose.ollama.yml sets 1).
# EVAL_MAX_CONCURRENCY=4
# Deliveries of one answer before a failing judge (5xx, connection refused)
# gives up and records it without a faithfulness score; until then the event is
# redelivered, so a short outage still gets every answer scored.
EVAL_MAX_DELIVERIES=5
